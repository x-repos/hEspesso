&CONTROL
    calculation      = 'scf'
    prefix           = 'mg2nih4_co_spinchk'
    pseudo_dir       = '/home/x/Workspace/3-hEspesso/pseudo'
    outdir           = './outdir/'
    restart_mode     = 'from_scratch'
    tprnfor          = .true.
    tstress          = .true.
    etot_conv_thr    = 1.0d-5
    forc_conv_thr    = 1.0d-4
    nstep            = 200
    max_seconds      = 21600
/

&SYSTEM
    ibrav            = 0
    nat              = 28
    ntyp             = 4
    ecutwfc          = 60.0
    ecutrho          = 480.0
    occupations      = 'smearing'
    smearing         = 'cold'
    degauss          = 0.01
    nspin            = 2
    starting_magnetization(1) = 0.4
    starting_magnetization(3) = 0.4
    
    nosym            = .true.
    noinv            = .true.
    vdw_corr         = 'DFT-D3'
    dftd3_version    = 4
/

&ELECTRONS
    electron_maxstep = 200
    conv_thr         = 1.0d-9
    mixing_beta      = 0.3
    mixing_mode      = 'plain'
    mixing_ndim      = 12
    diagonalization  = 'david'
    diago_david_ndim = 4
/

&IONS
    ion_dynamics = 'bfgs'
    trust_radius_max = 0.2
/

&CELL
    cell_dynamics = 'bfgs'
    press_conv_thr = 0.5
/

