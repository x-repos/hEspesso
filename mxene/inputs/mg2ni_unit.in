&CONTROL
    calculation      = 'relax'
    prefix           = 'mg2ni_unit'
    pseudo_dir       = '/home/x/Workspace/3-hEspesso/pseudo'
    outdir           = './outdir/'
    restart_mode     = 'from_scratch'
    tprnfor          = .true.
    etot_conv_thr    = 1.0d-5
    forc_conv_thr    = 1.0d-4
    nstep            = 150
    max_seconds      = 7200
/

&SYSTEM
    ibrav            = 1
    A                = 14.0
    nat              = 3
    ntyp             = 2
    ecutwfc          = 60.0
    ecutrho          = 600.0
    occupations      = 'smearing'
    smearing         = 'cold'
    degauss          = 0.02
    nspin            = 2
    starting_magnetization(1) = 0.5
    starting_magnetization(2) = 0.0
    vdw_corr         = 'DFT-D3'
    dftd3_version    = 4
/

&ELECTRONS
    electron_maxstep = 250
    conv_thr         = 1.0d-7
    mixing_beta      = 0.2
    mixing_mode      = 'local-TF'
    mixing_ndim      = 12
    diagonalization  = 'david'
    diago_david_ndim = 4
/

&IONS
    ion_dynamics     = 'bfgs'
/

ATOMIC_SPECIES
  Ni  58.6934   ni_pbe_v1.4.uspp.F.UPF
  Mg  24.305    Mg.pbe-n-kjpaw_psl.0.3.0.UPF

ATOMIC_POSITIONS angstrom
  Ni  7.000000   7.000000   7.000000
  Mg  9.600000   7.000000   7.000000
  Mg  5.700000   9.250000   7.000000

K_POINTS gamma
