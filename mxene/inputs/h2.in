&CONTROL
    calculation      = 'relax'
    prefix           = 'h2'
    pseudo_dir       = '/home/x/Workspace/3-hEspesso/pseudo'
    outdir           = './outdir/'
    restart_mode     = 'from_scratch'
    tprnfor          = .true.
    etot_conv_thr    = 1.0d-5
    forc_conv_thr    = 1.0d-4
    nstep            = 100
    max_seconds      = 3600
/

&SYSTEM
    ibrav            = 1
    A                = 12.0
    nat              = 2
    ntyp             = 1
    ecutwfc          = 60.0
    ecutrho          = 600.0
    occupations      = 'smearing'
    smearing         = 'gaussian'
    degauss          = 0.003
    nspin            = 1
    vdw_corr         = 'DFT-D3'
    dftd3_version    = 4
/

&ELECTRONS
    conv_thr         = 1.0d-9
    mixing_beta      = 0.5
/

&IONS
    ion_dynamics     = 'bfgs'
/

ATOMIC_SPECIES
  H    1.00794  H.pbe-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS angstrom
  H   6.000000   6.000000   6.000000
  H   6.000000   6.000000   6.740000

K_POINTS gamma
