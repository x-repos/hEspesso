&CONTROL
    calculation      = 'relax'
    prefix           = 'ti3c2_sqrt3'
    pseudo_dir       = '/home/x/Workspace/3-hEspesso/pseudo'
    outdir           = './outdir/'
    restart_mode     = 'from_scratch'
    tprnfor          = .true.
    etot_conv_thr    = 1.0d-5
    forc_conv_thr    = 1.0d-4
    nstep            = 200
    max_seconds      = 14400
/

&SYSTEM
    ibrav            = 0
    nat              = 15
    ntyp             = 2
    ecutwfc          = 60.0
    ecutrho          = 600.0
    occupations      = 'smearing'
    smearing         = 'cold'
    degauss          = 0.02
    nspin            = 2
    starting_magnetization(1) = 0.4
    starting_magnetization(2) = 0.0
    vdw_corr         = 'DFT-D3'
    dftd3_version    = 4
/

&ELECTRONS
    electron_maxstep = 250
    conv_thr         = 1.0d-7
    mixing_beta      = 0.2
    mixing_mode      = 'local-TF'
    mixing_ndim      = 12
    diago_david_ndim = 4
/

&IONS
    ion_dynamics     = 'bfgs'
/

