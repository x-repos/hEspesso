&CONTROL
    calculation      = 'relax'
    prefix           = 'mg2nih4_unit'
    pseudo_dir       = '/home/x/Workspace/3-hEspesso/pseudo'
    outdir           = './outdir/'
    restart_mode     = 'from_scratch'
    tprnfor          = .true.
    etot_conv_thr    = 1.0d-5
    forc_conv_thr    = 1.0d-4
    nstep            = 200
    max_seconds      = 10800
/

&SYSTEM
    ibrav            = 1
    A                = 16.0
    nat              = 7
    ntyp             = 3
    ecutwfc          = 60.0
    ecutrho          = 600.0
    occupations      = 'smearing'
    smearing         = 'gaussian'
    degauss          = 0.005
    nspin            = 2
    starting_magnetization(1) = 0.3
    starting_magnetization(2) = 0.0
    starting_magnetization(3) = 0.0
    vdw_corr         = 'DFT-D3'
    dftd3_version    = 4
/

&ELECTRONS
    conv_thr         = 1.0d-8
    mixing_beta      = 0.3
/

&IONS
    ion_dynamics     = 'bfgs'
/

ATOMIC_SPECIES
  Ni  58.6934   ni_pbe_v1.4.uspp.F.UPF
  Mg  24.305    Mg.pbe-n-kjpaw_psl.0.3.0.UPF
  H    1.00794  H.pbe-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS angstrom
  Ni  8.000000   8.000000   8.000000
  H   8.895000   8.895000   8.895000
  H   8.895000   7.105000   7.105000
  H   7.105000   8.895000   7.105000
  H   7.105000   7.105000   8.895000
  Mg  10.700000  8.000000   8.000000
  Mg  5.300000   8.000000   8.000000

K_POINTS gamma
